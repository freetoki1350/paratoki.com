---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import Footer from "../../components/Footer.astro";

interface AppEntry {
  slug: string;
  title: string;
  description: string;
  platform: string;
  status: string;
  storeUrl?: string;
  storeLabel?: string;
}

const apps: AppEntry[] = [
  {
    slug: "animetracker",
    title: "アニあと！〜私のアニメの軌跡〜",
    description:
      "アニメの視聴記録を端末ローカルに保存できる Android アプリ。視聴記録は端末内のみ、データは自分の手元に。",
    platform: "Android",
    status: "Google Play 公開中",
    storeUrl:
      "https://play.google.com/store/apps/details?id=com.paratoki.animetracker",
    storeLabel: "Google Play で入手",
  },
  {
    slug: "chickenote",
    title: "チックンノート",
    description:
      "お子さまの予防接種スケジュールを LINE で管理。前日の自動リマインダー付き。",
    platform: "LINE LIFF（ミニアプリ）",
    status: "公開中",
  },
  {
    slug: "torisetsu",
    title: "とりせつノート",
    description:
      "家電・家具の取扱説明書（PDF）を家族で一か所に集約。部屋別整理＋PDF本文の全文検索。招待コードで家族共有。",
    platform: "LINE LIFF（ミニアプリ）",
    status: "公開中",
  },
  {
    slug: "sukusuku",
    title: "すくすくノート",
    description:
      "乳幼児健診のスケジュール管理と成長記録（身長・体重・頭囲）を LINE で。健診の 1 週間前と前日にリマインダー。",
    platform: "LINE LIFF（ミニアプリ）",
    status: "公開中",
  },
  {
    slug: "pwdmanager",
    title: "かぎパスノート 〜オフラインで守るパスワード〜",
    description:
      "通信ゼロ・アカウント不要で守るパスワード管理。生体認証対応、全データは端末内で暗号化。",
    platform: "Android",
    status: "Google Play 公開中",
    storeUrl:
      "https://play.google.com/store/apps/details?id=com.paratoki.pwdmanager",
    storeLabel: "Google Play で入手",
  },
];
---

<BaseLayout
  title="アプリ一覧"
  description="Paratoki Lab が個人開発しているアプリの一覧。"
>
  <SiteNav />

  <h1>アプリ一覧</h1>
  <p class="tagline">Paratoki Lab で個人開発しているアプリです。</p>

  {
    apps.map((app) => (
      <div class="app">
        <h2>
          <a href={`/apps/${app.slug}/`}>{app.title}</a>
        </h2>
        <p>{app.description}</p>
        <p class="app-meta">
          <span class="platform">{app.platform}</span>
          {" ・ "}
          <span class="status">{app.status}</span>
        </p>
        {app.storeUrl && (
          <p class="store-link">
            <a href={app.storeUrl} target="_blank" rel="noopener noreferrer">
              {app.storeLabel}
            </a>
          </p>
        )}
      </div>
    ))
  }

  <Footer />
</BaseLayout>

<style>
  .app-meta {
    color: #888;
    font-size: 0.85em;
    margin-top: 8px;
  }
  .store-link {
    font-size: 0.9em;
    margin-top: 4px;
  }
</style>
