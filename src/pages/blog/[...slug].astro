---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await post.render();

const formatDate = (d: Date) =>
  `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;

const allPosts = await getCollection("blog", ({ data }) => !data.draft);

// 連載の前後ナビ
const seriesName = post.data.series;
const seriesNo = post.data.seriesNo;
const sameSeries =
  seriesName && seriesNo
    ? allPosts
        .filter((p) => p.data.series === seriesName && p.data.seriesNo)
        .sort((a, b) => a.data.seriesNo! - b.data.seriesNo!)
    : [];
const prevPost = sameSeries.find((p) => p.data.seriesNo === seriesNo! - 1);
const nextPost = sameSeries.find((p) => p.data.seriesNo === seriesNo! + 1);

// 連載目次へのリンク。series コレクションのタイトル（例: 「連載: LINE ミニアプリ開発記」）
// に連載名が含まれるものを引き当てる。
const seriesEntries = seriesName ? await getCollection("series") : [];
const seriesHub = seriesEntries.find((e) => e.data.title.includes(seriesName!));

// 関連記事: tags の重複数が多い順に最大 3 件。前後ナビと重複するものは除外。
const excluded = new Set(
  [post.slug, prevPost?.slug, nextPost?.slug].filter(Boolean) as string[]
);
const relatedPosts = allPosts
  .filter((p) => !excluded.has(p.slug))
  .map((p) => ({
    post: p,
    score: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
  }))
  .filter((r) => r.score > 0)
  .sort(
    (a, b) =>
      b.score - a.score ||
      b.post.data.publishDate.getTime() - a.post.data.publishDate.getTime()
  )
  .slice(0, 3)
  .map((r) => r.post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <SiteNav />

  <article>
    <h1>{post.data.title}</h1>
    {
      post.data.series && post.data.seriesNo && (
        <p class="series-badge">
          {post.data.series} 第 {post.data.seriesNo} 回
        </p>
      )
    }
    <p class="meta">
      <time datetime={post.data.publishDate.toISOString()}>
        {formatDate(post.data.publishDate)}
      </time>
      {
        post.data.updatedDate && (
          <span>
            （最終更新:{" "}
            <time datetime={post.data.updatedDate.toISOString()}>
              {formatDate(post.data.updatedDate)}
            </time>
            ）
          </span>
        )
      }
      {post.data.tags.length > 0 && (
        <span class="tags">
          {post.data.tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </span>
      )}
    </p>

    <Content />
  </article>

  {
    (prevPost || nextPost) && (
      <nav class="series-nav" aria-label="連載の前後の記事">
        {prevPost && (
          <a class="series-nav-item" href={`/blog/${prevPost.slug}/`}>
            <span class="series-nav-label">
              ← 前の記事（第 {prevPost.data.seriesNo} 回）
            </span>
            <span class="series-nav-title">{prevPost.data.title}</span>
          </a>
        )}
        {nextPost && (
          <a class="series-nav-item next" href={`/blog/${nextPost.slug}/`}>
            <span class="series-nav-label">
              次の記事（第 {nextPost.data.seriesNo} 回）→
            </span>
            <span class="series-nav-title">{nextPost.data.title}</span>
          </a>
        )}
      </nav>
    )
  }

  {
    seriesHub && (
      <p class="series-hub">
        <a href={`/series/${seriesHub.slug}/`}>
          {seriesName} の目次・読み方ガイドへ
        </a>
      </p>
    )
  }

  {
    relatedPosts.length > 0 && (
      <section class="related">
        <h2>関連記事</h2>
        <ul>
          {relatedPosts.map((p) => (
            <li>
              <a href={`/blog/${p.slug}/`}>{p.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <p style="margin-top: 3em;"><a href="/blog/">← ブログ一覧へ</a></p>

  <Footer />
</BaseLayout>

<style>
  .series-badge {
    display: inline-block;
    background: #e8f0fe;
    color: #1a73e8;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 0.85em;
    margin: 0 0 8px;
  }
  .meta {
    color: #999;
    font-size: 0.9em;
    margin-bottom: 2em;
  }
  .tags {
    margin-left: 12px;
  }
  .tag {
    background: #f0f0f0;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.85em;
    margin-right: 4px;
  }
  .series-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 3em;
  }
  .series-nav-item {
    flex: 1 1 240px;
    display: block;
    border: 1px solid #eee;
    border-radius: 6px;
    padding: 12px 16px;
    text-decoration: none;
    background: #fafafa;
  }
  .series-nav-item.next {
    text-align: right;
  }
  .series-nav-label {
    display: block;
    color: #999;
    font-size: 0.85em;
    margin-bottom: 4px;
  }
  .series-nav-title {
    display: block;
    font-size: 0.95em;
  }
  .series-hub {
    margin-top: 1.5em;
    font-size: 0.95em;
  }
  .related {
    margin-top: 3em;
  }
  .related h2 {
    font-size: 1.1em;
    border-bottom: 1px solid #eee;
    padding-bottom: 0.3em;
  }
  .related ul {
    line-height: 1.9;
    padding-left: 1.2em;
  }
  article :global(h2) {
    border-bottom: 1px solid #eee;
    padding-bottom: 0.3em;
  }
  article :global(pre) {
    background: #f6f8fa;
    padding: 16px;
    border-radius: 6px;
    overflow-x: auto;
  }
  article :global(code) {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.9em;
  }
  article :global(blockquote) {
    border-left: 4px solid #1a73e8;
    margin: 1em 0;
    padding: 0.5em 1em;
    color: #555;
    background: #f8f9fa;
  }
</style>
